# Copy this file to .env and fill it in. Never commit .env or share your token.
DISCORD_TOKEN=paste-your-bot-token-here

# Optional: your test server's ID. Slash commands then appear instantly
# instead of taking up to an hour to roll out globally.
# DEV_GUILD_ID=123456789012345678

# Optional: where the SQLite database is stored (default: bot.db next to bot.py)
# DATABASE_PATH=bot.db
